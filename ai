#!/usr/bin/env bash
set -euo pipefail

# Terminal-AI: a small Linux terminal client for Ollama.
# Requires: bash, curl, python3, and a running Ollama server.

exec python3 - "$@" <<'PY'
import argparse
import json
import os
import sqlite3
import subprocess
import sys
from pathlib import Path

OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434")
DEFAULT_MODEL = "qwen3:8b"
DB_PATH = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "terminal-ai" / "terminal-ai.db"


def db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(DB_PATH)
    con.execute("CREATE TABLE IF NOT EXISTS chats (name TEXT PRIMARY KEY, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)")
    con.execute("CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, chat TEXT NOT NULL, role TEXT NOT NULL, content TEXT NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY(chat) REFERENCES chats(name))")
    con.execute("INSERT OR IGNORE INTO chats(name) VALUES (?)", ("main",))
    con.commit()
    return con


def run_ollama(model, messages, think=False):
    payload = json.dumps({"model": model, "messages": messages, "stream": False, "think": think})
    try:
        result = subprocess.run(
            ["curl", "-fsS", "--max-time", "600", f"{OLLAMA_URL}/api/chat", "-H", "Content-Type: application/json", "-d", payload],
            text=True, capture_output=True,
        )
    except FileNotFoundError:
        print("error: curl is required", file=sys.stderr)
        sys.exit(1)
    if result.returncode != 0:
        print("error: could not reach Ollama", file=sys.stderr)
        print("Make sure Ollama is installed and running with: ollama serve", file=sys.stderr)
        if result.stderr:
            print(result.stderr.strip(), file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("error: Ollama returned invalid JSON", file=sys.stderr)
        print(result.stdout, file=sys.stderr)
        sys.exit(1)
    if "error" in data:
        print(f"error: {data['error']}", file=sys.stderr)
        sys.exit(1)
    return data["message"]["content"]


def model_exists(model):
    try:
        result = subprocess.run(["curl", "-fsS", "--max-time", "10", f"{OLLAMA_URL}/api/tags"], text=True, capture_output=True)
        if result.returncode != 0:
            return None
        models = json.loads(result.stdout).get("models", [])
        return model in {m.get("name", "") for m in models}
    except Exception:
        return None


def list_chats(con):
    rows = con.execute("SELECT c.name, COUNT(m.id) FROM chats c LEFT JOIN messages m ON m.chat = c.name GROUP BY c.name ORDER BY c.name").fetchall()
    for name, count in rows:
        print(f"{name}\t{count} messages")


def delete_chat(con, name):
    if name == "main":
        print("error: the main chat cannot be deleted; use --clear-memory instead", file=sys.stderr)
        sys.exit(1)
    con.execute("DELETE FROM messages WHERE chat = ?", (name,))
    con.execute("DELETE FROM chats WHERE name = ?", (name,))
    con.commit()
    print(f"deleted chat: {name}")


def clear_memory(con):
    con.execute("DELETE FROM messages")
    con.commit()
    print("cleared all saved conversation memory")


def load_messages(con, chat, new=False):
    if new:
        return []
    rows = con.execute("SELECT role, content FROM messages WHERE chat = ? ORDER BY id", (chat,)).fetchall()
    return [{"role": role, "content": content} for role, content in rows]


def save_message(con, chat, role, content):
    con.execute("INSERT INTO messages(chat, role, content) VALUES (?, ?, ?)", (chat, role, content))
    con.commit()


def ask(con, chat, model, prompt, messages, think):
    messages.append({"role": "user", "content": prompt})
    save_message(con, chat, "user", prompt)
    answer = run_ollama(model, messages, think)
    messages.append({"role": "assistant", "content": answer})
    save_message(con, chat, "assistant", answer)
    print(answer)


def main():
    parser = argparse.ArgumentParser(prog="ai", description="A persistent terminal AI client for Ollama.")
    parser.add_argument("prompt", nargs="*", help="prompt to send")
    parser.add_argument("-m", "--model", default=DEFAULT_MODEL, help=f"Ollama model (default: {DEFAULT_MODEL})")
    parser.add_argument("-c", "--chat", default="main", help="persistent chat name (default: main)")
    parser.add_argument("--new", action="store_true", help="ignore saved messages for this session")
    parser.add_argument("--think", action="store_true", help="enable Qwen/Ollama thinking mode (slower, useful for reasoning)")
    parser.add_argument("--new-chat", metavar="NAME", help="create/select a new persistent chat")
    parser.add_argument("--chats", action="store_true", help="list saved chats")
    parser.add_argument("--delete-chat", metavar="NAME", help="delete a saved chat")
    parser.add_argument("--clear-memory", action="store_true", help="delete all saved messages")
    args = parser.parse_args()

    if os.name != "posix":
        print("error: this version supports Linux only", file=sys.stderr)
        sys.exit(1)
    if subprocess.run(["bash", "-c", "command -v curl >/dev/null"], capture_output=True).returncode != 0:
        print("error: curl is required", file=sys.stderr)
        sys.exit(1)

    con = db()
    if args.chats:
        list_chats(con)
        return
    if args.clear_memory:
        clear_memory(con)
        return
    if args.delete_chat:
        delete_chat(con, args.delete_chat)
        return

    chat = args.new_chat or args.chat
    con.execute("INSERT OR IGNORE INTO chats(name) VALUES (?)", (chat,))
    con.commit()

    exists = model_exists(args.model)
    if exists is False:
        print(f"error: model '{args.model}' is not installed.", file=sys.stderr)
        print(f"Install it with: ollama pull {args.model}", file=sys.stderr)
        sys.exit(1)
    if exists is None:
        print("error: Ollama is not running or cannot be reached.", file=sys.stderr)
        print("Start it with: ollama serve", file=sys.stderr)
        sys.exit(1)

    messages = load_messages(con, chat, args.new)
    if args.prompt:
        ask(con, chat, args.model, " ".join(args.prompt), messages, args.think)
        return

    print(f"Terminal-AI | chat: {chat} | model: {args.model} | thinking: {'on' if args.think else 'off'}")
    print("Type /help for commands, /exit to quit. Saved messages persist between sessions.\n")
    while True:
        try:
            prompt = input("> ")
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not prompt.strip():
            continue
        if prompt in ("/exit", "/quit"):
            break
        if prompt == "/help":
            print("/exit              Exit")
            print("/new               Start with empty context for this session")
            print("/chats             List saved chats")
            print("/clear             Clear all saved messages")
            print("/think             Toggle thinking mode for this session")
            continue
        if prompt == "/new":
            messages = []
            print("Started a fresh context. Saved history remains on disk.")
            continue
        if prompt == "/chats":
            list_chats(con)
            continue
        if prompt == "/clear":
            clear_memory(con)
            messages = []
            continue
        if prompt == "/think":
            args.think = not args.think
            print(f"Thinking {'enabled' if args.think else 'disabled'} for this session.")
            continue
        ask(con, chat, args.model, prompt, messages, args.think)


if __name__ == "__main__":
    main()
PY

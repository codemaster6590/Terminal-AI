#!/usr/bin/env bash
set -euo pipefail

# Terminal-AI: a small Linux terminal client for Ollama.
exec python3 - "$@" <<'PY'
import json, os, sqlite3, subprocess, sys
from pathlib import Path

OLLAMA_URL = os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434")
DEFAULT_MODEL = "qwen3:8b"
DB_PATH = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "terminal-ai" / "terminal-ai.db"


def db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(DB_PATH)
    con.execute("CREATE TABLE IF NOT EXISTS chats (name TEXT PRIMARY KEY, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)")
    con.execute("CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, chat TEXT NOT NULL, role TEXT NOT NULL, content TEXT NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)")
    con.execute("INSERT OR IGNORE INTO chats(name) VALUES (?)", ("main",))
    con.commit()
    return con


def curl_json(path, payload=None, timeout=600):
    cmd = ["curl", "-fsS", "--max-time", str(timeout), f"{OLLAMA_URL}{path}"]
    if payload is not None:
        cmd += ["-H", "Content-Type: application/json", "-d", json.dumps(payload)]
    try:
        r = subprocess.run(cmd, text=True, capture_output=True)
    except FileNotFoundError:
        print("error: curl is required", file=sys.stderr); sys.exit(1)
    if r.returncode != 0:
        print("error: could not reach Ollama", file=sys.stderr)
        print("Start Ollama with: ollama serve", file=sys.stderr)
        if r.stderr: print(r.stderr.strip(), file=sys.stderr)
        sys.exit(1)
    try: return json.loads(r.stdout)
    except json.JSONDecodeError:
        print("error: Ollama returned invalid JSON", file=sys.stderr); sys.exit(1)


def model_exists(model):
    try:
        models = curl_json("/api/tags", timeout=10).get("models", [])
        return model in {m.get("name", "") for m in models}
    except SystemExit: return None


def run_ollama(model, messages, think):
    data = curl_json("/api/chat", {"model": model, "messages": messages, "stream": False, "think": think})
    if "error" in data:
        print(f"error: {data['error']}", file=sys.stderr); sys.exit(1)
    return data["message"]["content"]


def save(con, chat, role, content):
    con.execute("INSERT INTO messages(chat, role, content) VALUES (?, ?, ?)", (chat, role, content)); con.commit()


def load(con, chat):
    return [{"role": r, "content": c} for r, c in con.execute("SELECT role, content FROM messages WHERE chat=? ORDER BY id", (chat,))]


def chats(con):
    for name, count in con.execute("SELECT c.name, COUNT(m.id) FROM chats c LEFT JOIN messages m ON m.chat=c.name GROUP BY c.name ORDER BY c.name"):
        print(f"{name}\t{count} messages")


def ask(con, chat, model, prompt, messages, think):
    messages.append({"role":"user", "content":prompt}); save(con, chat, "user", prompt)
    answer = run_ollama(model, messages, think)
    messages.append({"role":"assistant", "content":answer}); save(con, chat, "assistant", answer)
    print(answer)


def main():
    # Easy words are accepted as commands, so help is optional.
    argv = sys.argv[1:]
    if argv and argv[0] in ("help", "?", "-h", "--help"):
        print("ai [message]                 Ask AI")
        print("ai new [name]                New chat")
        print("ai chats                     List chats")
        print("ai clear                     Clear memory")
        print("ai delete [name]             Delete chat")
        print("ai think [message]           Ask with thinking enabled")
        print("ai model [name] [message]    Use another model")
        print("ai --think [message]         Same as above")
        return

    model = DEFAULT_MODEL; chat = "main"; think = False; new = False
    prompt = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--think", "-t"):
            think = True; i += 1; continue
        if a in ("--new",):
            new = True; i += 1; continue
        if a in ("--model", "-m") and i + 1 < len(argv):
            model = argv[i+1]; i += 2; continue
        if a in ("--chat", "-c") and i + 1 < len(argv):
            chat = argv[i+1]; i += 2; continue
        if a == "think":
            think = True; i += 1; continue
        if a == "model" and i + 1 < len(argv):
            model = argv[i+1]; i += 2; continue
        prompt.append(a); i += 1

    # Human-friendly management commands.
    if prompt and prompt[0] in ("chats", "list") and len(prompt) == 1:
        con = db(); chats(con); return
    if prompt and prompt[0] == "clear" and len(prompt) == 1:
        con = db(); con.execute("DELETE FROM messages"); con.commit(); print("Memory cleared."); return
    if prompt and prompt[0] == "delete" and len(prompt) >= 2:
        con = db(); name = prompt[1]
        if name == "main": print("The main chat cannot be deleted. Use: ai clear", file=sys.stderr); return
        con.execute("DELETE FROM messages WHERE chat=?", (name,)); con.execute("DELETE FROM chats WHERE name=?", (name,)); con.commit(); print(f"Deleted chat: {name}."); return
    if prompt and prompt[0] == "new":
        chat = prompt[1] if len(prompt) > 1 else "main"
        new = True; prompt = []
        if len(argv) > 2: prompt = argv[2:]
    if prompt and prompt[0] == "chat" and len(prompt) >= 2:
        chat = prompt[1]; prompt = prompt[2:]

    con = db(); con.execute("INSERT OR IGNORE INTO chats(name) VALUES (?)", (chat,)); con.commit()
    exists = model_exists(model)
    if exists is False:
        print(f"error: model '{model}' is not installed.", file=sys.stderr)
        print(f"Install it with: ollama pull {model}", file=sys.stderr); sys.exit(1)
    if exists is None: sys.exit(1)

    messages = [] if new else load(con, chat)
    if prompt:
        ask(con, chat, model, " ".join(prompt), messages, think); return

    print(f"Terminal-AI | {chat} | {model} | thinking {'on' if think else 'off'}")
    print("Type a message, /new, /chats, /clear, /think, or /exit.\n")
    while True:
        try: text = input("> ")
        except (EOFError, KeyboardInterrupt): print(); return
        text = text.strip()
        if not text: continue
        if text in ("/exit", "/quit", "exit", "quit"): return
        if text in ("/chats", "chats"): chats(con); continue
        if text in ("/clear", "clear"): con.execute("DELETE FROM messages"); con.commit(); messages=[]; print("Memory cleared."); continue
        if text in ("/new", "new"): messages=[]; print("Fresh context."); continue
        if text == "/think" or text == "think": think = not think; print(f"Thinking {'on' if think else 'off'}."); continue
        ask(con, chat, model, text, messages, think)


if __name__ == "__main__": main()
PY

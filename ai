#!/usr/bin/env bash
set -euo pipefail

API_URL="https://api.openai.com/v1/responses"
MODEL="${AI_MODEL:-gpt-5.6}"

if [[ -z "${OPENAI_API_KEY:-}" ]]; then
    printf 'error: OPENAI_API_KEY is not set\n' >&2
    printf "Set it with: export OPENAI_API_KEY='your-key'\n" >&2
    exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
    printf 'error: curl is required\n' >&2
    exit 1
fi

ask() {
    local prompt="$1"
    local response
    local status

    response=$(curl -sS -w '\n%{http_code}' \
        "$API_URL" \
        -H 'Content-Type: application/json' \
        -H "Authorization: Bearer $OPENAI_API_KEY" \
        -d "$(printf '%s' "$prompt" | python3 -c 'import json,sys; print(json.dumps({"model":"'"$MODEL"'","input":sys.stdin.read()}))')")"

    status="${response##*$'\n'}"
    response="${response%$'\n'*}"

    if [[ "$status" -lt 200 || "$status" -ge 300 ]]; then
        printf 'error: API returned HTTP %s\n' "$status" >&2
        printf '%s\n' "$response" >&2
        return 1
    fi

    python3 -c '
import json, sys
r = json.load(sys.stdin)
for item in r.get("output", []):
    for content in item.get("content", []):
        if content.get("type") == "output_text":
            print(content.get("text", ""), end="")
' <<< "$response"
    printf '\n'
}

if [[ $# -gt 0 ]]; then
    ask "$*"
    exit $?
fi

while true; do
    printf '> '
    if ! IFS= read -r prompt; then
        printf '\n'
        break
    fi

    case "$prompt" in
        /exit|/quit)
            break
            ;;
        '')
            continue
            ;;
    esac

    ask "$prompt"
done
